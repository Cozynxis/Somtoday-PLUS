{
  "manifest_version": 3,
  "name": "Somtoday+",
  "version": "1.0",
  "description": "Maak Somtoday een veel fijnere website, met nieuwe instellingen en meer om het zo goed mogelijk te maken voor jou.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.somtoday.nl/*", "*://som.today/*"],
  "content_scripts": [{
    "matches": ["*://*.somtoday.nl/*", "*://som.today/*"],
    "js": [
      "src/core/storage.js",
      "src/features/theme.js",
      "src/features/enhancements.js",
      "src/settings/settings.js",
      "src/settings/integration.js",
      "src/core/app.js"
    ],
    "css": ["src/styles/somtoday-plus.css", "src/styles/features.css"],
    "run_at": "document_end"
  }],
  "background": {"service_worker": "src/background.js"},
  "action": {"default_title": "Somtoday PLUS+", "default_popup": "popup.html"}
}
